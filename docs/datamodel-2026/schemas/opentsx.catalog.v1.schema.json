{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentsx.org/schemas/opentsx.catalog.v1.schema.json",
  "title": "opentsx.catalog.v1",
  "description": "A frozen catalog version: the immutable set of (id, version) pairs a runtime may run, each with the SHA-256 of the test vectors that define its output. See docs/datamodel-2026/20-WAYANG-TS-OPERATORS-SPEC.md, S1.1.",
  "type": "object",
  "required": ["schema", "catalog", "operators"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "opentsx.catalog.v1"},
    "catalog": {"type": "string", "pattern": "^tsx-catalog/[1-9][0-9]*$"},
    "operators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "version", "sha256"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9-]+)*$", "description": "Id of the opentsx.processor.v1 description."},
          "version": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Lower-case hex SHA-256 of the bytes of the vector file named by the description (testvectors)."}
        }
      }
    }
  }
}
