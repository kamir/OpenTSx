{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentsx.org/schemas/opentsx.aggregate-evidence.v1.schema.json",
  "title": "opentsx.aggregate-evidence.v1",
  "description": "Bounded JVM source-cut evidence. Admission validates every identity and exact input cut against the signed assignment, and verifies the payload hash. This attests completed computation before publication acknowledgement and checkpoint persistence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "job", "site", "planVersion", "generation", "assignment", "fence", "specHash", "fragmentHash", "inputs", "payloadSha256"],
  "properties": {
    "schema": {"const": "opentsx.aggregate-evidence.v1"},
    "kind": {"const": "bounded-source-cut"},
    "job": {"$ref": "#/$defs/id"},
    "site": {"$ref": "#/$defs/id"},
    "planVersion": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "generation": {"$ref": "#/$defs/positive"},
    "assignment": {"$ref": "#/$defs/id"},
    "fence": {"$ref": "#/$defs/positive"},
    "specHash": {"$ref": "#/$defs/hash"},
    "fragmentHash": {"$ref": "#/$defs/hash"},
    "payloadSha256": {"$ref": "#/$defs/hash"},
    "inputs": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/input"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "positive": {"type": "string", "pattern": "^[1-9][0-9]{0,18}$"},
    "offset": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,18})$"},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding", "topic", "partitionCount", "positions"],
      "properties": {
        "binding": {"$ref": "#/$defs/id"},
        "topic": {"type": "string", "maxLength": 249, "pattern": "^tsx\\.[a-z0-9][a-z0-9_-]*\\.[a-z0-9][a-z0-9-]*(?:\\.[a-z0-9][a-z0-9-]*)*\\.v[1-9][0-9]*$"},
        "partitionCount": {"type": "string", "pattern": "^[1-9][0-9]{0,9}$"},
        "positions": {"type": "array", "items": {"$ref": "#/$defs/position"}}
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["partition", "from", "to"],
      "properties": {
        "partition": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,9})$"},
        "from": {"$ref": "#/$defs/offset"},
        "to": {"$ref": "#/$defs/offset"}
      }
    }
  }
}
