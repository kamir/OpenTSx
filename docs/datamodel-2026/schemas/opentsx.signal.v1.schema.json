{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentsx.org/schemas/opentsx.signal.v1.schema.json",
  "title": "opentsx.signal.v1",
  "description": "Draft. One discrete finding at a site: a data-quality result, a segment begin or end, a threshold crossing. Written to tsx.<domain>.signals.v1, key = seriesId. Signals are collected, not merged. See docs/datamodel-2026/20-WAYANG-TS-OPERATORS-SPEC.md, S4.6.",
  "type": "object",
  "required": ["schema", "id", "job", "site", "seriesId", "kind", "at", "specHash"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "opentsx.signal.v1"},
    "id": {"type": "string", "pattern": "^[0-9a-f]{16}$", "description": "Lower-case hex xxHash64 of job|site|seriesId|kind|at (S6.2)."},
    "job": {"type": "string"},
    "site": {"type": "string"},
    "seriesId": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "kind": {"enum": ["dq", "segment.begin", "segment.end", "threshold.enter", "threshold.exit"]},
    "at": {"type": "string", "format": "date-time", "description": "Event time of the finding."},
    "window": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "from": {"type": "string", "format": "date-time"},
        "to": {"type": "string", "format": "date-time"}
      }
    },
    "check": {"enum": ["COMPLETENESS", "PLAUSIBLE_RANGE", "FLATLINE", "GAPS", "FRESHNESS"], "description": "For kind dq: DataQuality.Check."},
    "status": {"enum": ["SUCCESS", "FAILED", "ABORTED"], "description": "For kind dq: DataQuality.Status."},
    "value": {"type": ["number", "null"], "description": "The one value that triggered the finding; no other raw values."},
    "threshold": {"type": "string"},
    "message": {"type": "string"},
    "specHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision": {"type": "integer", "minimum": 0, "default": 0}
  }
}
