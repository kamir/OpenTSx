{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentsx.org/schemas/opentsx.runner-plan.v1.schema.json",
  "title": "opentsx.runner-plan.v1",
  "description": "Draft. The plan one site receives for one federated job: the site stage of a workbench DAG document (opentsx.dag.v1 or v2, unchanged in form) plus the contract the site runs under. Sent as the payload of a compact JWS. See docs/datamodel-2026/20-WAYANG-TS-OPERATORS-SPEC.md, S2.4.",
  "type": "object",
  "required": ["schema", "job", "planVersion", "issued", "expires", "site", "catalog", "specHash", "dag", "inputs", "outputs", "start"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "opentsx.runner-plan.v1"},
    "job": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "planVersion": {"type": "integer", "minimum": 1},
    "issued": {"type": "string", "format": "date-time"},
    "expires": {"type": "string", "format": "date-time"},
    "site": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "catalog": {"type": "string", "pattern": "^tsx-catalog/[1-9][0-9]*$"},
    "specHash": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Lower-case hex SHA-256 of the UTF-8 text of the site stage document."},
    "dag": {"type": "object", "required": ["nodes", "sinks"], "description": "The site stage as a DAG document in JSON form."},
    "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/topic"}},
    "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/output"}},
    "start": {
      "oneOf": [
        {"enum": ["earliest", "latest"]},
        {"type": "object", "description": "Offsets per topic and partition.", "additionalProperties": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}}
      ]
    },
    "federation": {
      "type": "object",
      "required": ["route", "expectedSites", "groupBy", "maxDelay"],
      "additionalProperties": false,
      "properties": {
        "route": {"enum": ["signal-cluster", "job-state"]},
        "expectedSites": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "groupBy": {"type": "array", "uniqueItems": true, "items": {"type": "string"}, "description": "Tag names that form the group key; empty: one group per metric."},
        "maxDelay": {"type": "string", "pattern": "^P", "description": "ISO 8601 duration after the window end until a window is written as not final."}
      }
    }
  },
  "$defs": {
    "topic": {
      "type": "object",
      "required": ["topic", "fingerprints", "partitions"],
      "additionalProperties": false,
      "properties": {
        "topic": {"type": "string", "pattern": "^tsx\\.[a-z0-9-]+\\.[a-z0-9.-]+\\.v[0-9]+$"},
        "fingerprints": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9a-f]{16}$"}, "description": "CRC-64-AVRO fingerprints allowed on the input topic."},
        "partitions": {"type": "integer", "minimum": 1}
      }
    },
    "output": {
      "type": "object",
      "required": ["topic", "cluster"],
      "additionalProperties": false,
      "properties": {
        "topic": {"type": "string", "pattern": "^tsx\\.[a-z0-9-]+\\.[a-z0-9.-]+\\.v[0-9]+$"},
        "cluster": {"enum": ["site", "signal"]},
        "fingerprints": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{16}$"}},
        "schema": {"type": "string", "description": "JSON record schema for JSON topics, for example opentsx.signal.v1."}
      }
    }
  }
}
