{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentsx.org/schemas/opentsx.runner-plan.v1.schema.json",
  "title": "opentsx.runner-plan.v1",
  "description": "Signed site wrapper for bounded JVM statistics or isolated continuous Rust pass-through. Semantic validation binds the unchanged assignment, exact source and fragment text, runtime, complete topic inventory and output bindings. The payload is limited to 128 KiB. The JVM branch requires federation and a SeriesStats sink; the Rust branch forbids federation and admits one local Episode sink.",
  "type": "object",
  "required": [
    "schema",
    "job",
    "planVersion",
    "issued",
    "expires",
    "site",
    "catalog",
    "specHash",
    "assignmentText",
    "inputContracts",
    "outputs"
  ],
  "oneOf": [
    {
      "required": ["federation"],
      "properties": {
        "outputs": {
          "items": {
            "properties": {
              "fingerprints": {"items": {"const": "e51b48188baa6606"}}
            }
          }
        }
      }
    },
    {
      "not": {"required": ["federation"]},
      "properties": {
        "inputContracts": {
          "maxItems": 1,
          "items": {
            "properties": {
              "fingerprints": {"maxItems": 1, "items": {"const": "8985f02b48c77195"}}
            }
          }
        },
        "outputs": {
          "items": {
            "properties": {
              "cluster": {"const": "site"},
              "fingerprints": {"items": {"const": "8985f02b48c77195"}}
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "opentsx.runner-plan.v1"
    },
    "job": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "planVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "issued": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "expires": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "site": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "catalog": {
      "type": "string",
      "pattern": "^tsx-catalog/[1-9][0-9]*$"
    },
    "specHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "assignmentText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "description": "Exact UTF-8 opentsx.execution-assignment.v1 text, limited to 65536 bytes by semantic validation."
    },
    "inputContracts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": [
          "binding",
          "topic",
          "fingerprints"
        ],
        "additionalProperties": false,
        "properties": {
          "binding": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          },
          "topic": {
            "type": "string",
            "pattern": "^tsx\\.[a-z0-9][a-z0-9_-]*\\.[a-z0-9][a-z0-9-]*(?:\\.[a-z0-9][a-z0-9-]*)*\\.v[1-9][0-9]*$",
            "maxLength": 249
          },
          "fingerprints": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            }
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sink",
          "cluster",
          "topic",
          "partitionCount",
          "fingerprints"
        ],
        "additionalProperties": false,
        "properties": {
          "sink": {
            "type": "string",
            "minLength": 1,
            "maxLength": 249,
            "description": "Exact compiler sink identity of the admitted fragment."
          },
          "cluster": {
            "enum": [
              "site",
              "signal"
            ]
          },
          "topic": {
            "type": "string",
            "pattern": "^tsx\\.[a-z0-9][a-z0-9_-]*\\.[a-z0-9][a-z0-9-]*(?:\\.[a-z0-9][a-z0-9-]*)*\\.v[1-9][0-9]*$",
            "maxLength": 249
          },
          "partitionCount": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$",
            "maxLength": 19
          },
          "fingerprints": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "enum": ["e51b48188baa6606", "8985f02b48c77195"]
            }
          }
        }
      }
    },
    "federation": {
      "type": "object",
      "required": [
        "route",
        "expectedAssignments",
        "scopes",
        "groupBy",
        "maxDelay"
      ],
      "additionalProperties": false,
      "properties": {
        "route": {
          "enum": [
            "signal-cluster",
            "job-state"
          ]
        },
        "expectedAssignments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "required": [
              "assignment",
              "site",
              "node",
              "generation",
              "fence",
              "fragmentHash"
            ],
            "additionalProperties": false,
            "properties": {
              "assignment": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
              },
              "site": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
              },
              "node": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
              },
              "generation": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$",
                "maxLength": 19
              },
              "fence": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$",
                "maxLength": 19
              },
              "fragmentHash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "type": "object",
            "required": [
              "groupId",
              "windowType",
              "startMicros",
              "endMicros"
            ],
            "additionalProperties": false,
            "properties": {
              "groupId": {
                "type": "string",
                "pattern": "^[0-9a-f]{16}$"
              },
              "windowType": {
                "type": "string",
                "pattern": "^P"
              },
              "startMicros": {
                "type": "string",
                "pattern": "^(0|-?[1-9][0-9]*)$",
                "maxLength": 20
              },
              "endMicros": {
                "type": "string",
                "pattern": "^(0|-?[1-9][0-9]*)$",
                "maxLength": 20
              }
            }
          },
          "uniqueItems": true
        },
        "groupBy": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "maxDelay": {
          "type": "string",
          "pattern": "^P"
        }
      }
    }
  }
}
