{
  "schema": "opentsx.testvectors.align-vector.v1",
  "description": "Shared test vectors of the operator align.vector (docs/datamodel-2026/11, section 5a). Times are seconds since the epoch, null is a missing value. Run by opentsx-saas-frontend (vector.test.ts) and opentsx-retrieval (VectorAlignerTest).",
  "cases": [
    {
      "name": "two inputs, one vector per series, mean per tick",
      "params": { "every": 60, "key": "series", "agg": "MEAN", "fill": "none", "maxAge": 60, "emit": "any" },
      "inputs": [
        { "name": "raw", "series": [ { "id": "a", "metric": "wind.met.wind_speed", "tags": { "turbine": "T01" }, "t": [0, 30, 60, 90], "v": [1, 3, 5, 7] } ] },
        { "name": "slow", "series": [ { "id": "a", "metric": "wind.met.wind_speed", "tags": { "turbine": "T01" }, "t": [0, 60], "v": [10, 20] } ] }
      ],
      "expect": [
        { "key": { "turbine": "T01", "series": "a" }, "from": 0, "components": ["raw", "slow"], "values": [2, 10] },
        { "key": { "turbine": "T01", "series": "a" }, "from": 60, "components": ["raw", "slow"], "values": [6, 20] }
      ]
    },
    {
      "name": "one input with several channels, one vector per turbine",
      "params": { "every": 60, "key": "turbine", "agg": "MEAN", "fill": "none", "maxAge": 60, "emit": "any" },
      "inputs": [
        { "name": "raw", "series": [
          { "id": "a", "metric": "wind.met.wind_speed", "tags": { "park": "p", "turbine": "T01" }, "t": [0], "v": [5] },
          { "id": "b", "metric": "wind.turbine.power_active", "tags": { "park": "p", "turbine": "T01" }, "t": [0], "v": [400] },
          { "id": "c", "metric": "wind.met.wind_speed", "tags": { "park": "p", "turbine": "T02" }, "t": [60], "v": [7] },
          { "id": "d", "metric": "wind.turbine.power_active", "tags": { "park": "p", "turbine": "T02" }, "t": [0], "v": [900] }
        ] }
      ],
      "expect": [
        { "key": { "turbine": "T01" }, "from": 0, "components": ["power_active", "wind_speed"], "values": [400, 5] },
        { "key": { "turbine": "T02" }, "from": 0, "components": ["power_active", "wind_speed"], "values": [900, null] },
        { "key": { "turbine": "T02" }, "from": 60, "components": ["power_active", "wind_speed"], "values": [null, 7] }
      ]
    },
    {
      "name": "a missing component is filled as-of up to the maximum age",
      "params": { "every": 60, "key": "series", "agg": "MEAN", "fill": "as-of", "maxAge": 120, "emit": "any" },
      "inputs": [
        { "name": "fast", "series": [ { "id": "s", "metric": "m.fast", "tags": {}, "t": [0, 60, 120, 180, 240], "v": [1, 2, 3, 4, 5] } ] },
        { "name": "rare", "series": [ { "id": "s", "metric": "m.rare", "tags": {}, "t": [0, 240], "v": [10, 50] } ] }
      ],
      "expect": [
        { "key": { "series": "s" }, "from": 0, "components": ["fast", "rare"], "values": [1, 10] },
        { "key": { "series": "s" }, "from": 60, "components": ["fast", "rare"], "values": [2, 10] },
        { "key": { "series": "s" }, "from": 120, "components": ["fast", "rare"], "values": [3, 10] },
        { "key": { "series": "s" }, "from": 180, "components": ["fast", "rare"], "values": [4, null] },
        { "key": { "series": "s" }, "from": 240, "components": ["fast", "rare"], "values": [5, 50] }
      ]
    },
    {
      "name": "emit complete drops ticks with a missing component",
      "params": { "every": 60, "key": "series", "agg": "MEAN", "fill": "none", "maxAge": 60, "emit": "complete" },
      "inputs": [
        { "name": "fast", "series": [ { "id": "s", "metric": "m.fast", "tags": {}, "t": [0, 60, 120, 180, 240], "v": [1, 2, 3, 4, 5] } ] },
        { "name": "rare", "series": [ { "id": "s", "metric": "m.rare", "tags": {}, "t": [0, 240], "v": [10, 50] } ] }
      ],
      "expect": [
        { "key": { "series": "s" }, "from": 0, "components": ["fast", "rare"], "values": [1, 10] },
        { "key": { "series": "s" }, "from": 240, "components": ["fast", "rare"], "values": [5, 50] }
      ]
    },
    {
      "name": "ticks are multiples of the clock since the epoch; last value per tick; missing samples are skipped",
      "params": { "every": 60, "key": "all", "agg": "LAST", "fill": "none", "maxAge": 60, "emit": "any" },
      "inputs": [
        { "name": "x", "series": [ { "id": "s", "metric": "m.x", "tags": {}, "t": [1790812825, 1790812835, 1790812850, 1790812865, 1790812925], "v": [1, 2, null, 3, 4] } ] }
      ],
      "expect": [
        { "key": {}, "from": 1790812800, "components": ["x"], "values": [2] },
        { "key": {}, "from": 1790812860, "components": ["x"], "values": [3] },
        { "key": {}, "from": 1790812920, "components": ["x"], "values": [4] }
      ]
    },
    {
      "name": "two inputs with several channels each, everything in one vector; sum, count, min, max",
      "params": { "every": 10, "key": "all", "agg": "SUM", "fill": "none", "maxAge": 10, "emit": "any" },
      "inputs": [
        { "name": "raw", "series": [
          { "id": "a", "metric": "wind.met.wind_speed", "tags": {}, "t": [0, 1, 2], "v": [4, 1, 7] },
          { "id": "b", "metric": "wind.turbine.power_active", "tags": {}, "t": [0, 5], "v": [100, 300] }
        ] },
        { "name": "twice", "series": [
          { "id": "a", "metric": "wind.met.wind_speed", "tags": {}, "t": [0, 1, 2], "v": [8, 2, 14] },
          { "id": "b", "metric": "wind.turbine.power_active", "tags": {}, "t": [0, 5], "v": [200, 600] }
        ] }
      ],
      "expect": [
        { "key": {}, "from": 0, "components": ["raw.power_active", "raw.wind_speed", "twice.power_active", "twice.wind_speed"], "values": [400, 12, 800, 24] }
      ],
      "also": { "COUNT": [2, 3, 2, 3], "MIN": [100, 1, 200, 2], "MAX": [300, 7, 600, 14], "FIRST": [100, 4, 200, 8], "MEAN": [200, 4, 400, 8] }
    }
  ]
}
