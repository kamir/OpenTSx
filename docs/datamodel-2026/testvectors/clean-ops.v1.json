{
 "schema": "opentsx.testvectors.clean-ops.v1",
 "description": "Cleaning operators on one series. times are seconds relative to t0; null is a gap (NaN). Every case ends on the boundary of a window, so a run over all the data and a stream that has passed the end give the same. nodes is the form of the DAG (CleanChain, Java), workbench the form of the web workbench (ops.ts).",
 "cases": [
  {
   "name": "plausible range, gaps",
   "t0": "2026-10-01T00:00:00Z",
   "intervalSeconds": 10,
   "nodes": [
    {
     "id": "n1",
     "op": "dq.checks",
     "params": {
      "checks": [
       "PLAUSIBLE_RANGE"
      ],
      "min": 0,
      "max": 100,
      "mode": "gap"
     }
    }
   ],
   "workbench": [
    {
     "op": "dq.plausible-range",
     "params": {
      "min": 0,
      "max": 100,
      "mode": "gap"
     }
    }
   ],
   "values": [
    5,
    -1,
    50,
    101,
    100,
    0,
    null,
    42
   ],
   "expect": {
    "times": [
     0,
     10,
     20,
     30,
     40,
     50,
     60,
     70
    ],
    "values": [
     5,
     null,
     50,
     null,
     100,
     0,
     null,
     42
    ]
   }
  },
  {
