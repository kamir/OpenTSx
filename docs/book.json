{
  "title": "OpenTSx Documentation",
  "description": "Comprehensive documentation for the OpenTSx Time Series Analysis Framework",
  "author": "OpenTSx Core Team",
  "language": "en",
  "gitbook": ">=3.0.0",
  "root": ".",

  "structure": {
    "readme": "README.md",
    "summary": "SUMMARY.md"
  },

  "plugins": [
    "theme-default",
    "fontsettings",
    "highlight",
    "search",
    "sharing",
    "back-to-top-button",
    "copy-code-button",
    "expandable-chapters",
    "anchor-navigation-ex",
    "github",
    "edit-link",
    "-lunr",
    "-search",
    "search-plus",
    "splitter",
    "page-toc-button"
  ],

  "pluginsConfig": {
    "theme-default": {
      "showLevel": true,
      "styles": {
        "website": "styles/website.css",
        "pdf": "styles/pdf.css",
        "epub": "styles/epub.css",
        "mobi": "styles/mobi.css"
      }
    },
    "fontsettings": {
      "theme": "white",
      "family": "sans",
      "size": 2
    },
    "github": {
      "url": "https://github.com/kamir/OpenTSx"
    },
    "edit-link": {
      "base": "https://github.com/kamir/OpenTSx/edit/main/docs",
      "label": "Edit This Page"
    },
    "sharing": {
      "facebook": false,
      "twitter": true,
      "google": false,
      "weibo": false,
      "all": ["facebook", "google", "twitter", "weibo"]
    },
    "anchor-navigation-ex": {
      "showLevel": false,
      "showGoTop": true
    },
    "page-toc-button": {
      "maxTocDepth": 2,
      "minTocSize": 2
    }
  },

  "pdf": {
    "pageNumbers": true,
    "fontSize": 12,
    "fontFamily": "Arial",
    "paperSize": "a4",
    "margin": {
      "right": 62,
      "left": 62,
      "top": 56,
      "bottom": 56
    },
    "headerTemplate": "<div style='text-align:center; font-size:10px; color:#888;'>OpenTSx Documentation</div>",
    "footerTemplate": "<div style='text-align:center; font-size:10px; color:#888;'>Page _PAGENUM_ of _TOTAL_</div>"
  },

  "links": {
    "sidebar": {
      "GitHub Repository": "https://github.com/kamir/OpenTSx",
      "Issue Tracker": "https://github.com/kamir/OpenTSx/issues",
      "OpenTSx Website": "https://opentsx.org"
    }
  },

  "variables": {
    "version": "3.0.0",
    "pythonVersion": "1.0.0",
    "javaVersion": "1.8+",
    "kafkaVersion": "2.3.0"
  }
}
