{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Processing Flow Descriptor",
    "description": "A definition of a time series processing pipeline for OpenTSx",
    "type": "object",
    "properties": {
        "name": {
            "type": "string",
            "description": "Name of the processing flow",
            "minLength": 1,
            "pattern": "\\S"
        },
        "version": {
            "type": "string",
            "description": "Version of the flow definition"
        },
        "input": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "enum": [
                        "KAFKA"
                    ]
                },
                "topic": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                },
                "schema": {
                    "type": "string"
                }
            },
            "required": [
                "type",
                "topic"
            ]
        },
        "steps": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                    },
                    "operation": {
                        "type": "string",
                        "enum": [
                            "NORMALIZE"
                        ]
                    },
                    "params": {
                        "type": "object",
                        "properties": {
                            "method": {
                                "type": "string",
                                "enum": [
                                    "center"
                                ]
                            }
                        },
                        "additionalProperties": false
                    }
                },
                "required": [
                    "id",
                    "operation"
                ]
            }
        },
        "output": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "enum": [
                        "LOG"
                    ]
                },
                "topic": {
                    "type": "string"
                },
                "path": {
                    "type": "string"
                }
            },
            "required": [
                "type"
            ]
        }
    },
    "required": [
        "name",
        "input",
        "steps",
        "output"
    ]
}
