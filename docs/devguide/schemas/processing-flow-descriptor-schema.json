{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Processing Flow Descriptor",
    "description": "A definition of a time series processing pipeline for OpenTSx",
    "type": "object",
    "properties": {
        "name": {
            "type": "string",
            "description": "Name of the processing flow"
        },
        "version": {
            "type": "string",
            "description": "Version of the flow definition"
        },
        "input": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "enum": [
                        "KAFKA",
                        "FILE",
                        "GENERATOR"
                    ]
                },
                "topic": {
                    "type": "string"
                },
                "schema": {
                    "type": "string"
                }
            },
            "required": [
                "type"
            ]
        },
        "steps": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "operation": {
                        "type": "string",
                        "enum": [
                            "WINDOW_AGGREGATE",
                            "NORMALIZE",
                            "FILTER",
                            "DECOMPOSE",
                            "DETECT_ANOMALY",
                            "SMOOTH",
                            "DFA"
                        ]
                    },
                    "params": {
                        "type": "object",
                        "additionalProperties": true
                    }
                },
                "required": [
                    "id",
                    "operation"
                ]
            }
        },
        "output": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "enum": [
                        "KAFKA",
                        "FILE",
                        "LOG",
                        "OPENTSDB"
                    ]
                },
                "topic": {
                    "type": "string"
                },
                "path": {
                    "type": "string"
                }
            },
            "required": [
                "type"
            ]
        }
    },
    "required": [
        "name",
        "input",
        "steps",
        "output"
    ]
}