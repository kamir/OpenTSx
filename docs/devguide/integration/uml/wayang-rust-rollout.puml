@startuml
title Local publication and whole-topic authority replacement
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam ArrowColor #34536F
skinparam participantBackgroundColor #E8F0F8
skinparam noteBackgroundColor #FFF5D6

actor User
participant "Backend / coordinator" as api
database "PostgreSQL" as pg
participant "Wayang stage" as stage
participant "Three Rust workers\none complete topic each" as workers
participant "Publication gateway" as gateway
database "Private ledger" as ledger
participant "Write Proxy / broker" as kafka

User -> api : deploy exact DAG
api -> pg : persist plan, clock and ownership
api -> stage : reconcile exact admitted plan
stage -> gateway : admit complete topic group / obtain grants
gateway -> ledger : persist current epoch and private grants
stage -> workers : install grants, then prepare
workers -> workers : read via read Proxy, compute and retain candidate
workers --> stage : prepared digests and series ownership
stage -> stage : verify all preparations and disjoint ownership
stage -> gateway : register exact requests, digests and counts
stage -> workers : activate exact prepared requests
workers -> gateway : publish with captured token and epoch
critical Serialized publication and authority transition
  gateway -> ledger : fsync publishing intent
  gateway -> kafka : Produce via write Proxy
  alt All records acknowledged
    kafka --> gateway : acknowledgements
    gateway -> ledger : fsync acknowledged receipt
    gateway --> workers : verified publication receipt
    workers -> workers : commit completed checkpoint
  else Unknown broker outcome
    break Publication outcome remains unresolved
      gateway -> ledger : retain publishing / uncertain
      gateway --> workers : refuse automatic retransmission
      note over api,gateway
      Keep topic ownership. No replacement or retirement
      while this group's write outcome remains unknown.
      end note
    end
  end
end
workers --> stage : completed receipts
stage --> api : verified completed boundary
api -> pg : persist cumulative progress

User -> api : replace(expectedEpoch, resume or restart)
api -> pg : persist switch intent, drain dispatched work
api -> stage : operation + verified old plan/result
opt Restart changed DAG
  stage -> stage : require same input placement and fresh empty output
end
stage -> gateway : rotate whole topic group under publication lock
gateway -> ledger : atomically revoke old grants and persist larger epoch
alt Resume identical DAG
  stage -> workers : install new grants against old completed heads
  workers -> workers : preserve state, cursors and open windows
else Restart changed DAG
  stage -> workers : reset with expected old heads after revocation
  workers -> workers : new deployment, sequence one, cursors zero
end
stage --> api : same recorded operation result
api -> pg : record active epoch and ownership transfer
workers -> gateway : restored OLD candidate with captured OLD grant
gateway --> workers : deny before Kafka I/O
note over gateway,kafka
Old-token denial leaves output end offsets unchanged.
Cached durable acknowledgements are safe HTTP retries.
There is no atomic publication across workers or gateway HA.
end note
@enduml
