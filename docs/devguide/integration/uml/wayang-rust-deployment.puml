@startuml
!pragma layout smetana
top to bottom direction
title Local three-worker Wayang deployment with publication fencing
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam componentStyle uml2
skinparam ArrowColor #34536F
skinparam nodeBackgroundColor #F3F6FA
skinparam componentBackgroundColor #E8F0F8
skinparam noteBackgroundColor #FFF5D6

actor User
node "Control network 172.29.76.0/24" {
  component "Frontend\nui_host_net\nloopback :18081" as ui
  component "Authenticated backend" as api
  component "Coordinator\nPostgreSQL advisory lock" as coordinator
  database "PostgreSQL\nplans, ownership, switch intent" as pg
}
node "Wayang process" {
  component "RustPlatform / RustExecutor\nprepare + ownership checks\n\nControl HTTP: 172.29.76.10:8095\nprivate run token\nPublication HTTP: 172.29.74.10:8096\ncaptured per-node grants\nWriter interface: 172.29.75.10" as driver
  database "Private publication ledger\nprocess lock + atomic fsync\n64 groups / 64 operation slots\nretirement slots reserved\n256 requests / 4 MiB" as ledger
}
node "Worker network 172.29.74.0/24\nread-only roots, no Linux capabilities" as workers {
  component "Rust worker 1\nwhole topic A\n1 partition" as r1
  component "Rust worker 2\nwhole topic B\n2 partitions" as r2
  component "Rust worker 3\nwhole topic C\n3 partitions" as r3
}
node "Broker network 172.29.73.0/24" {
  component "Read Proxy\nworker .74.2\nbroker .73.10" as read
  component "Write Proxy\nwriter .75.2 / broker .73.11\nproxy_host_net\nhost fixture loopback :39093" as write
  database "KafScale Broker\nACL remote_addr, default deny\nno published host port" as broker
  database "Private etcd metadata" as etcd
}

User --> ui
ui --> api : exact UI DAG / replace
api --> pg : persist plans and intent
coordinator --> pg : reconcile control
coordinator --> driver : authenticated control
driver --> ledger : serialize publication and rotation
driver <--> workers : prepare / activate\nreturn captured output to gateway
workers --> read : read complete topic cuts
driver --> write : acknowledged publication
read --> broker : fetch only
write --> broker : produce / provision
broker --> etcd : metadata

note bottom of workers
Workers cannot reach broker or writer networks.
Read-proxy Produce is denied by broker ACL.
Host port bridges are separate, one service each.
The host and Docker control plane remain trusted.
end note
note left of ledger
One active gateway process.
Unknown broker outcome blocks handover.
No automatic failover or atomic multi-worker write.
end note
@enduml
