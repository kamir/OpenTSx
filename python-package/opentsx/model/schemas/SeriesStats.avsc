{
  "type": "record",
  "name": "SeriesStats",
  "namespace": "org.opentsx.model.v2",
  "doc": "Running or windowed statistics of one series, emitted by the streaming statistics processor.",
  "fields": [
    {"name": "seriesId", "type": "string"},
    {"name": "windowType", "type": "string", "doc": "GLOBAL, or an ISO-8601 duration of a tumbling window, e.g. PT1H."},
    {"name": "windowStart", "type": {"type": "long", "logicalType": "timestamp-micros"}},
    {"name": "windowEnd", "type": {"type": "long", "logicalType": "timestamp-micros"}},
    {"name": "validCount", "type": "long"},
    {"name": "nanCount", "type": "long", "default": 0},
    {"name": "min", "type": "double"},
    {"name": "max", "type": "double"},
    {"name": "mean", "type": "double"},
    {"name": "m2", "type": "double"},
    {"name": "quantileSketch", "type": ["null", "bytes"], "default": null},
    {"name": "gapCount", "type": "long", "default": 0},
    {"name": "lastSeen", "type": ["null", {"type": "long", "logicalType": "timestamp-micros"}], "default": null}
  ]
}
