# OpenTSx on k3s - configuration. 20-configure.sh writes deploy/k3s/.env (git-ignored) from this file, your
# environment and its options; every script reads .env. Never commit real credentials.

# --- cluster -------------------------------------------------------------------------------------------------
OPENTSX_NS=opentsx                 # namespace for everything
KUBECTL="kubectl"                  # e.g. "sudo k3s kubectl" if kubectl is not configured for your user
STORAGE_CLASS=                     # empty = cluster default (k3s: local-path)

# --- KafScale (existing cluster) -------------------------------------------------------------------------------
KAFSCALE_BOOTSTRAP=192.168.1.50:9092   # host:port as reachable FROM THE PODS (not "localhost")
KAFSCALE_NETWORK=direct            # direct | hostnetwork | service   (see docs/devops/setup-plan.md, step 3)
OPENTSX_DOMAIN=wind                # topics tsx.<domain>.{episodes,buckets,series,observations,series-stats}.v2
OPENTSX_PARTITIONS=6               # data partitions when OpenTSx creates the topics

# --- images ----------------------------------------------------------------------------------------------------
OPENTSX_IMAGE_REPO=opentsx         # images <repo>/tools and <repo>/studio; e.g. registry.local:5000/opentsx
OPENTSX_TAG=3.0.0-local
OPENTSX_PLATFORM=                  # empty = native; linux/arm64 for a Raspberry Pi (docker buildx)
IMAGE_METHOD=docker                # how 11-import-images.sh loads images: docker | podman | nerdctl | registry | ssh

# --- optional: lake profile (Iceberg REST catalog + S3) ----------------------------------------------------------
LAKE=false                         # true: Iceberg REST catalog, retrieval server on Iceberg, windpark-sim -> Iceberg
LAKE_MINIO=true                    # true: run MinIO in the cluster; false: use S3_ENDPOINT below
S3_ENDPOINT=                       # default with LAKE_MINIO=true: http://opentsx-minio:9000
S3_BUCKET=lake
S3_REGION=us-east-1
S3_ACCESS_KEY=                     # generated for in-cluster MinIO when empty; stored only in .env / the Secret
S3_SECRET_KEY=

# --- optional: OpenMetadata -------------------------------------------------------------------------------------
OM_URL=                            # e.g. http://openmetadata.example:8585/api
OPENMETADATA_JWT=                  # bot token; stored only in .env / the Secret

# --- optional: expose Studio and the retrieval API via the k3s Traefik ingress ------------------------------------
INGRESS=false
