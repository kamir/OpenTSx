# OpenTSx on k3s - configuration. 20-configure.sh writes deploy/k3s/.env (git-ignored) from this file, your
# environment and its options; every script reads .env. Never commit real credentials.

# --- cluster -------------------------------------------------------------------------------------------------
OPENTSX_NS=opentsx                 # namespace for everything
KUBECTL="kubectl"                  # e.g. "sudo k3s kubectl" if kubectl is not configured for your user
STORAGE_CLASS=                     # empty = cluster default (k3s: local-path)

# --- KafScale (existing cluster) -------------------------------------------------------------------------------
KAFSCALE_BOOTSTRAP=192.168.1.50:9092   # host:port as reachable FROM THE PODS (not "localhost")
KAFSCALE_NETWORK=direct            # direct | hostnetwork | service   (see docs/devops/setup-plan.md, step 3)
OPENTSX_DOMAIN=wind                # topics tsx.<domain>.{episodes,buckets,series,observations,series-stats}.v2
OPENTSX_PARTITIONS=6               # data partitions when OpenTSx creates the topics

# --- images ----------------------------------------------------------------------------------------------------
OPENTSX_IMAGE_REPO=opentsx         # images <repo>/tools and <repo>/studio; e.g. registry.local:5000/opentsx
OPENTSX_TAG=3.0.0-local
OPENTSX_PLATFORM=                  # empty = native; linux/arm64 for a Raspberry Pi (docker buildx)
IMAGE_METHOD=docker                # how 11-import-images.sh loads images: docker | podman | nerdctl | registry | ssh

# --- optional: lake profile (Iceberg REST catalog + S3) ----------------------------------------------------------
LAKE=false                         # true: Iceberg REST catalog, retrieval server on Iceberg, windpark-sim -> Iceberg
LAKE_MINIO=true                    # true: run MinIO in the cluster; false: use S3_ENDPOINT below
S3_ENDPOINT=                       # default with LAKE_MINIO=true: http://opentsx-minio:9000
S3_BUCKET=lake
S3_REGION=us-east-1
S3_ACCESS_KEY=                     # generated for in-cluster MinIO when empty; stored only in .env / the Secret
S3_SECRET_KEY=

# --- optional: OpenMetadata -------------------------------------------------------------------------------------
OM_URL=                            # e.g. http://openmetadata.example:8585/api
OPENMETADATA_JWT=                  # bot token; stored only in .env / the Secret

# --- retrieval server: where its episodes come from ---------------------------------------------------------------
RETRIEVAL_SOURCE=demo              # demo: three synthetic series | kafscale: the topic tsx.<domain>.episodes.v2, held
                                   # in memory (needs the episodes of 40-demo.sh or your own). LAKE=true reads Iceberg.
RETRIEVAL_DAG_RUNS=false           # true (with RETRIEVAL_SOURCE=kafscale): POST /v1/dags/deploy and /stop hand DAGs to the
                                   # vector processor (control topic), for callers with the run token only.
RETRIEVAL_DAG_RUN_TOKEN=           # generated when empty; the SaaS backend gets it and forwards what its users deploy
VECTOR_PROCESSOR=false             # true: opentsx-vectors, the processor that keeps the vector Smart Topics
                                   # (tsx.<domain>.smart.<name>.vectors.v1) up to date; one pod, state on a volume

# --- optional: expose Studio and the retrieval API via the k3s Traefik ingress ------------------------------------
INGRESS=false

# --- optional: DWD weather (opentsx-dwd) --------------------------------------------------------------------------
DWD_FORWARD=false                  # true: CronJob opentsx-dwd-forward fetches MOSMIX daily (needs internet from the pods)
DWD_STATIONS=10578,10579           # MOSMIX station ids (10578 Fichtelberg, 10579 Marienberg, 10091 Arkona)
DWD_SCHEDULE="17 5 * * *"          # cron schedule of opentsx-dwd-forward (cluster time zone, usually UTC)
DWD_MODE=online                    # online | offline (offline = the MOSMIX fixture in the image, no internet needed)

# --- optional: Modbus meters (opentsx-modbus) ----------------------------------------------------------------------
MODBUS_SIM=false                   # true: Deployment opentsx-modbus-sim (simulated meter, example map, port 1502)
MODBUS_HOST=opentsx-modbus-sim     # where the modbus-poll Job connects (the simulator Service, or a real converter)
MODBUS_PORT=1502
MODBUS_MAP=example                 # "example" or a path in the image / a mounted ConfigMap

# --- optional: monitoring -------------------------------------------------------------------------------------------
MONITORING=false                   # true: CronJob opentsx-synthetic-check + Prometheus rules ConfigMap (operations.md)
# --- optional: SaaS module (frontend with the web workbench, backend, PostgreSQL) ------------------------------------
SAAS=false                         # true: opentsx-saas-{frontend,backend,db}; page at http://<node>:30311/workbench
SAAS_ADMIN_EMAIL=admin@opentsx.com # first administrator account, created when the backend starts on an empty database
SAAS_ADMIN_PASSWORD=               # generated when empty; stored only in .env / the Secret opentsx-saas-secrets
SAAS_DAG_RUN_ROLE=superuser        # who may deploy and stop DAGs: superuser = administrators | user = every account.
                                   # Anyone can register an account, so "user" opens writing to everyone who reaches the page.
SAAS_DB_PASSWORD=                  # generated when empty; fixed once the database volume exists
SAAS_SECRET_KEY=                   # signs the login tokens; generated when empty
EVENT_BRIDGE=false                 # true: opentsx-event-bridge (twin event topics as server-sent events) at http://<node>:30312
EVENT_BRIDGE_ALLOW_ORIGIN='*'      # origin the bridge answers browsers from; narrow it to the Studio's address where possible
