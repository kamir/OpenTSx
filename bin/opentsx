#!/usr/bin/env bash
# OpenTSx command launcher.
#
#   bin/opentsx <command> [options]
#
# Commands:
#   windpark-sim       run a wind-farm scenario -> KafScale and/or Iceberg   (org.opentsx.windpark.WindparkSim)
#   stats              streaming statistics processor on KafScale            (org.opentsx.stats.StatsProcessorApp)
#   metadata           publish the metadata pool to OpenMetadata             (org.opentsx.openmetadata.WindparkMetadata)
#   retrieval-server   REST API for episodes, patterns, segments             (org.opentsx.retrieval.server.RetrievalServer)
#   vectors            vector processor: run | deploy | stop                 (org.opentsx.retrieval.vector.VectorProcessorApp)
#   twin               digital twin demo S1 (H2 chain) in all three modes    (org.opentsx.twin.demo.H2ChainDemo)
#   house              house twin: KPIs + levers; --calibrate f|--simulated  (org.opentsx.twin.demo.HouseDemo)
#   boat               boat twin (Etap 22): what-ifs, --data, --simulated     (org.opentsx.twin.demo.BoatDemo)
#   dwd                DWD collector: stations, mosmix, obs, house            (org.opentsx.dwd.DwdCli)
#   modbus             Modbus meters: check|read|poll|simulate --map f.yaml   (org.opentsx.modbus.ModbusCli)
#   twin-coupling      variant L vs T: staleness/latency grid, --csv f        (org.opentsx.twin.demo.CouplingStudy)
#   twin-live          event topic: publish|bridge|demo (events of a run -> topic -> browser)  (org.opentsx.twin.live.TwinLive)
#   twin-schemas       regenerate the twin's Avro topic contract, --out dir    (org.opentsx.twin.schema.AtomSchemas)
#   market             market data: prices, rebap, marktwert, import, backfill, report, load
#                                                                            (org.opentsx.market.MarketCli)
#   twin --history d   twin S1 on archived history (year, real prices + wind)  (org.opentsx.market.twin.HistoryTwins)
#   house --weather-year Y, boat --weather-year Y   same for house and boat (archive: --history data/history)
#   classpath <module> print the runtime classpath of a module
#
# Requires a prior build: mvn -q install -DskipTests   (JDK 17+)
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"

usage() { sed -n '2,/^set -euo/{/^#/p}' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

classpath() {   # module... -> classpath (cached per module in target/classpath.txt)
  local cp="" m
  for m in "$@"; do
    local f="$ROOT/$m/target/classpath.txt"
    if [[ ! -f "$f" || "$ROOT/$m/pom.xml" -nt "$f" ]]; then
      (cd "$ROOT" && mvn -q -B -pl "$m" dependency:build-classpath -Dmdep.outputFile=target/classpath.txt >/dev/null)
    fi
    [[ -d "$ROOT/$m/target/classes" ]] || { echo "module $m is not built - run: mvn -q install -DskipTests" >&2; exit 1; }
    cp="$cp:$ROOT/$m/target/classes:$(cat "$f")"
  done
  echo "${cp#:}"
}

[[ $# -ge 1 ]] || usage 1
cmd="$1"; shift
case "$cmd" in
  windpark-sim)     exec java -cp "$(classpath opentsx-windpark)" org.opentsx.windpark.WindparkSim "$@" ;;
  stats)            exec java -cp "$(classpath opentsx-stats)" org.opentsx.stats.StatsProcessorApp "$@" ;;
  metadata)         exec java -cp "$(classpath opentsx-openmetadata)" org.opentsx.openmetadata.WindparkMetadata "$@" ;;
  retrieval-server) exec java -cp "$(classpath opentsx-retrieval opentsx-store-iceberg)" org.opentsx.retrieval.server.RetrievalServer "$@" ;;
  vectors) exec java -cp "$(classpath opentsx-retrieval)" org.opentsx.retrieval.vector.VectorProcessorApp "$@" ;;
  twin|house|boat)
    # with archived history (--history / --weather-year) the run goes through the history adapter of opentsx-market
    if [[ " $* " == *" --history "* || " $* " == *" --weather-year "* ]]; then
      exec java -cp "$(classpath opentsx-market)" org.opentsx.market.twin.HistoryTwins "$cmd" "$@"
    fi
    case "$cmd" in
      twin)  exec java -cp "$(classpath opentsx-twin)" org.opentsx.twin.demo.H2ChainDemo "$@" ;;
      house) exec java -cp "$(classpath opentsx-twin)" org.opentsx.twin.demo.HouseDemo "$@" ;;
      boat)  exec java -cp "$(classpath opentsx-twin)" org.opentsx.twin.demo.BoatDemo "$@" ;;
    esac ;;
  market)           exec java -cp "$(classpath opentsx-market)" org.opentsx.market.MarketCli "$@" ;;
  dwd)              exec java -cp "$(classpath opentsx-dwd)" org.opentsx.dwd.DwdCli "$@" ;;
  modbus)           exec java -cp "$(classpath opentsx-modbus)" org.opentsx.modbus.ModbusCli "$@" ;;
  twin-coupling)    exec java -cp "$(classpath opentsx-twin)" org.opentsx.twin.demo.CouplingStudy "$@" ;;
  twin-live)        exec java -cp "$(classpath opentsx-twin-live)" org.opentsx.twin.live.TwinLive "$@" ;;
  twin-schemas)     exec java -cp "$(classpath opentsx-twin)" org.opentsx.twin.schema.AtomSchemas "$@" ;;
  classpath)        classpath "$@" ;;
  -h|--help|help)   usage 0 ;;
  *) echo "unknown command: $cmd" >&2; usage 1 ;;
esac
