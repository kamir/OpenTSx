# Application Settings
PROJECT_NAME=OpenTSx SaaS Platform
API_V1_STR=/api/v1
DEBUG=True

# Security - ⚠️ CHANGE THESE IN PRODUCTION!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-this-in-production-use-random-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
# Format: postgresql+asyncpg://username:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/opentsx

# First Superuser (Created automatically on first run)
# ⚠️ CHANGE THESE IN PRODUCTION!
FIRST_SUPERUSER_EMAIL=admin@opentsx.com
FIRST_SUPERUSER_PASSWORD=admin123

# CORS (Allowed origins for frontend)
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Optional: Email Configuration (for verification emails)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAILS_FROM_EMAIL=noreply@opentsx.com
