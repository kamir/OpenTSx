# Type: long.
# opentsx.modbus.simulator.seed 42

# Modbus unit id of the meter; overrides the register map.
# Type: int; no default.
# opentsx.modbus.unitId

# Statistics window that the data-quality results are computed on.
# Type: duration.
# opentsx.openmetadata.dqWindow PT10M

# Directory the requests are written to instead of sending them to OpenMetadata.
# Type: path; no default.
# opentsx.openmetadata.dryRunDir

# Statistics window that is published as the table profile.
# Type: duration.
# opentsx.openmetadata.profileWindow PT1H

# Publish profiles and data-quality results from the statistics topic; auto publishes them when opentsx.kafscale.bootstrap is set on the command line.
# Type: enum, one of auto, always, never.
# opentsx.openmetadata.profiles auto

# Bot token (JWT) for the OpenMetadata API.
# Type: string; secret: environment or file only; no default.
# opentsx.openmetadata.token

# Base URL of the OpenMetadata API, ending in /api.
# Type: string; no default.
# opentsx.openmetadata.url

# Address the retrieval server listens on; without it, every interface, or 127.0.0.1 when opentsx.retrieval.openDagRuns is true.
# Type: string; no default.
# opentsx.retrieval.bind

# Token a caller of the DAG write routes must send in the header X-OpenTSx-Run-Token.
# Type: string; secret: environment or file only; no default.
# opentsx.retrieval.dagRunToken

# Offer POST /v1/dags/deploy and /v1/dags/stop, which write to the control topic of the vector processor.
# Type: boolean.
# opentsx.retrieval.dagRuns false

# Most episodes the server keeps in memory from the episodes topic.
# Type: int.
# opentsx.retrieval.maxEpisodes 20000

# Accept DAG runs without a run token; the server then listens on 127.0.0.1 only.
# Type: boolean.
# opentsx.retrieval.openDagRuns false

# HTTP port of the retrieval server.
# Type: int.
# opentsx.retrieval.port 8080

# How often the server polls the episodes topic for new records.
# Type: duration.
# opentsx.retrieval.refreshInterval PT30S

# Store the retrieval server serves; auto takes iceberg when opentsx.iceberg.properties is set on the command line, kafscale when opentsx.kafscale.bootstrap is, else demo; both on the command line is an error.
# Type: enum, one of auto, demo, iceberg, kafscale.
# opentsx.retrieval.source auto

# Directory of system documents (*.system.yaml) behind /v1/systems.
# Type: path; no default.
# opentsx.retrieval.systems

# Directory the references in the system documents are relative to.
# Type: path.
# opentsx.retrieval.systemsRoot .

# How long a closed window still accepts late episodes.
# Type: duration.
# opentsx.stats.allowedLateness PT0S

# Checkpoint file of the processor; without it the processor starts from the beginning every time.
# Type: path; no default.
# opentsx.stats.checkpoint

# Interval of the Flink checkpoints.
# Type: duration.
# opentsx.stats.checkpointInterval PT30S

# How often the Flink job emits the global statistics of a series.
# Type: duration.
# opentsx.stats.globalInterval PT30S

# Also read the observations topic of the domain.
# Type: boolean.
# opentsx.stats.observations false

# Process the backlog, close all windows and exit.
# Type: boolean.
# opentsx.stats.once false

# Relative accuracy of the quantile sketch.
# Type: double.
# opentsx.stats.sketchAlpha 0.01

# Window lengths of the statistics.
# Type: list of duration.
# opentsx.stats.windows PT10M,PT1H

