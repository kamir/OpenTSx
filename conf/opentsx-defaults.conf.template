# Defaults file in the properties format, with every key of the registry opentsx.config.v1 at project
# version 3.0.1. Generated by org.opentsx.conf.ConfReference.
#
# Copy this file to $OPENTSX_CONF_DIR/opentsx-defaults.conf. To set a key, remove the "# " in front of it and
# write its value after the key; a key without default has no value yet. A line is "key value" or
# "key = value"; a line that starts with # or ! is a comment; a backslash is an error. A # after
# the key is part of the value.
# opentsx config list, config show, config get, opentsx version, code that calls OpenTsxConf.load and
# every command whose bin/opentsx <command> --help prints a keys: section read this file; code, the
# command line, the environment and --properties-file win over it. Every other command of bin/opentsx
# parses its own flags and does not read it. The commands of bin/opentsx that read it: boat, dwd house, dwd mosmix, dwd obs, dwd stations, house, metadata, modbus check, modbus poll, modbus read, modbus simulate, retrieval-server, stats, stats-flink, studio-export, twin, twin-coupling, twin-live bridge, twin-live demo, twin-live publish, twin-schemas, vectors, vectors deploy, vectors run, vectors stop, windpark-sim.

# Root directory of the history archive.
# Type: path.
# opentsx.archive.dir data/history

# Fit solar derating and usage scales to the operating data first.
# Type: boolean.
# opentsx.boat.calibrate false

# Operating data CSV of the boat.
# Type: path; no default.
# opentsx.boat.data

# Time zone of the timestamps in the operating data.
# Type: string.
# opentsx.boat.zone Europe/Berlin

# Domain of the topic names tsx.<domain>.<kind>.v2.
# Type: string.
# opentsx.domain wind

# CSV file of irradiance for the boat twin.
# Type: path; no default.
# opentsx.dwd.boat

# CSV file of daily mean temperatures for the house twin.
# Type: path; no default.
# opentsx.dwd.daily

# Read the hourly recent observations instead of the 10-minute now observations.
# Type: boolean.
# opentsx.dwd.hourly false

# Position LAT,LON the nearest stations are searched for.
# Type: list of double; no default.
# opentsx.dwd.near

# Number of stations listed.
# Type: int.
# opentsx.dwd.nearestCount 5

# Local observation files read instead of a download from opendata.dwd.de.
# Type: list of path; no default.
# opentsx.dwd.obs.offline

# Local file read instead of a download from opendata.dwd.de.
# Type: path; no default.
# opentsx.dwd.offline

# Wide CSV file the series are written to.
# Type: path; no default.
# opentsx.dwd.out

# Observation parameters; without it wind,air_temperature,solar, or wind,air_temperature with hourly.
# Type: list of enum, one of wind, air_temperature, solar, precipitation; no default.
# opentsx.dwd.params

# DWD station id.
# Type: string; no default.
# opentsx.dwd.station

# Station catalog: mosmix for forecast ids, cdc for observation ids.
# Type: enum, one of mosmix, cdc.
# opentsx.dwd.stationCatalog mosmix

# Number of days of the trip.
# Type: int.
# opentsx.history.boat.days 14

# First day (YYYY-MM-DD) of the trip; without it the first Saturday from July 1.
# Type: string; no default.
# opentsx.history.boat.start

# Weather year of the boat trip.
# Type: int.
# opentsx.history.boat.weatherYear 2024

# Also print every lever as a what-if per year.
# Type: boolean.
# opentsx.history.house.levers false

# Weather year YYYY or range YYYY-YYYY of the house twin.
# Type: string.
# opentsx.history.house.weatherYear 2023

# Radiation station id; overrides the sites file.
# Type: string; no default.
# opentsx.history.radiationStation

# Sites file (YAML) of the twins; without it the built-in sites are used.
# Type: path; no default.
# opentsx.history.sites

# Temperature station id; overrides the sites file.
# Type: string; no default.
# opentsx.history.station

# Mean capacity factor the SMARD wind is scaled to.
# Type: double.
# opentsx.history.twin.capacityFactor 0.30

# Number of days of the run; without it the rest of the year.
# Type: int; no default.
# opentsx.history.twin.days

# First UTC day (YYYY-MM-DD) of the run; without it January 1 of the year.
# Type: string; no default.
# opentsx.history.twin.from

# Wind input: SMARD onshore wind scaled to the park, or a DWD station through the power curve.
# Type: enum, one of smard, dwd.
# opentsx.history.twin.wind smard

# Year of the history run.
# Type: int.
# opentsx.history.twin.year 2024

# Bills CSV the house twin is calibrated on.
# Type: path; no default.
# opentsx.house.bills

# Reference heating degree days the final heat is normalized to.
# Type: double, unit Kd.
# opentsx.house.hddRef 4300

# Daily temperatures CSV used with the calibration.
# Type: path; no default.
# opentsx.house.weather

# HTTPS proxy for downloads, used when the JVM property https.proxyHost is not set.
# Type: string; secret: environment or file only; no default.
# opentsx.https.proxy

# Iceberg namespace of the OpenTSx tables.
# Type: string.
# opentsx.iceberg.namespace tsx

# Iceberg catalog properties as key=value items, for example type=rest,uri=http://localhost:8181; shown in clear, so keep credentials out of it.
# Type: list; no default.
# opentsx.iceberg.properties

# Bootstrap address of the KafScale proxy as host:port, several separated by commas.
# Type: string; no default.
# opentsx.kafscale.bootstrap

# How long the check waits for each request to the broker.
# Type: duration.
# opentsx.kafscale.checkTimeout PT20S

# Number of data partitions when OpenTSx creates the topics of a domain.
# Type: int.
# opentsx.kafscale.partitions 6

# Create the topics of the domain that do not exist yet.
# Type: boolean.
# opentsx.kafscale.provision false

# Lowest level of the log lines: slf4j-simple in Java, the logger opentsx in Python.
# Type: enum, one of error, warn, info, debug, trace.
# opentsx.log.level info

