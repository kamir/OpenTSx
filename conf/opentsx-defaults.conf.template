# opentsx.market.backfillDelayMs 500

# Security token of the ENTSO-E transparency platform.
# Type: string; secret: environment or file only; no default.
# opentsx.market.entsoeToken

# Pause between two requests to a source.
# Type: long, unit ms.
# opentsx.market.fetchDelayMs 300

# Fetch years again that the archive marks as complete.
# Type: boolean.
# opentsx.market.force false

# Start: a local date (Europe/Berlin, start of day) or an ISO instant.
# Type: string; no default.
# opentsx.market.from

# First UTC day (YYYY-MM-DD) to load or publish.
# Type: string; no default.
# opentsx.market.fromDay

# First year to load or publish.
# Type: int.
# opentsx.market.fromYear 2000

# Partner CSV file to import.
# Type: path; no default.
# opentsx.market.import.file

# Metric of the imported series.
# Type: string; no default.
# opentsx.market.import.metric

# Origin of the imported values.
# Type: enum, one of REPORTED, FORECAST.
# opentsx.market.import.origin REPORTED

# Partner tag of the imported series.
