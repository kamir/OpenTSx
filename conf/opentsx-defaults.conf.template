# opentsx.market.import.zone

# MOSMIX station ids to archive.
# Type: list.
# opentsx.market.mosmix.stations 10579,10097,10046,E5411

# Series path source/name, or the name of a partner series.
# Type: string; no default.
# opentsx.market.name

# OAuth client id for the Netztransparenz API.
# Type: string; secret: environment or file only; no default.
# opentsx.market.ntpClientId

# OAuth client secret for the Netztransparenz API.
# Type: string; secret: environment or file only; no default.
# opentsx.market.ntpClientSecret

# Downloaded file parsed instead of a request to the source.
# Type: path; no default.
# opentsx.market.offline

# CSV file the fetched series is written to.
# Type: path; no default.
# opentsx.market.out

# Episodes per batch sent to the broker.
# Type: int.
# opentsx.market.publish.batch 100

# Count what would be published without writing to the broker.
# Type: boolean.
# opentsx.market.publish.dryRun false

# Pause between two batches.
# Type: long, unit ms.
# opentsx.market.publish.pauseMs 3000

# Series paths source/name to publish.
# Type: list; no default.
# opentsx.market.publish.series

# Recompute the quality reports from the archived files.
# Type: boolean.
# opentsx.market.requality false

# Series to report or load: all-archived, all, market, or source/name items separated by commas.
# Type: string.
# opentsx.market.series all-archived

# Source of the day-ahead prices.
# Type: enum, one of smard, energy-charts, entsoe.
# opentsx.market.source smard

# Store the fetched series into the history archive; auto stores them when opentsx.archive.dir is set on the command line.
# Type: enum, one of auto, always, never.
# opentsx.market.store auto

# End, exclusive: a local date (Europe/Berlin, start of day) or an ISO instant.
# Type: string; no default.
# opentsx.market.to

# UTC day (YYYY-MM-DD) before which loading or publishing stops.
# Type: string; no default.
# opentsx.market.toDay

# Last year to load or publish.
# Type: int.
# opentsx.market.toYear 2100

# Station and parameter pairs station:parameter; without it every station of the sites file.
# Type: list; no default.
# opentsx.market.weather.stations

# Number of poll cycles; 0 polls until stopped.
# Type: long.
# opentsx.modbus.count 0

# Length of the episodes the poll normalizes into.
# Type: duration.
# opentsx.modbus.episodeLength PT1M

# File the CSV rows or the episodes are written to instead of stdout.
# Type: path; no default.
# opentsx.modbus.file

# Host of the meter; overrides the register map.
# Type: string; no default.
# opentsx.modbus.host

# Poll interval; overrides the register map.
# Type: duration; no default.
# opentsx.modbus.interval

# Register map file (YAML) or example.
# Type: string; no default.
# opentsx.modbus.map

# Output of the poll: csv rows or episodes.
# Type: enum, one of csv, episodes.
# opentsx.modbus.out csv

# TCP port of the meter; overrides the register map.
# Type: int; no default.
# opentsx.modbus.port

