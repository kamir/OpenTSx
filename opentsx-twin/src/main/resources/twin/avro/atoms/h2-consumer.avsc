{
  "type" : "record",
  "name" : "H2ConsumerSnapshot",
  "namespace" : "org.opentsx.twin.v1.atoms",
  "doc" : "Snapshot of one h2-consumer atom after superstep k (phase SOURCES)",
  "fields" : [ {
    "name" : "run_id",
    "type" : "string"
  }, {
    "name" : "atom",
    "type" : "string",
    "doc" : "instance id, the record key"
  }, {
    "name" : "k",
    "type" : "int"
  }, {
    "name" : "t",
    "type" : {
      "type" : "long",
      "logicalType" : "timestamp-micros"
    }
  }, {
    "name" : "state",
    "type" : {
      "type" : "record",
      "name" : "H2ConsumerState",
      "doc" : "State variables of h2-consumer",
      "fields" : [ {
        "name" : "requested_kg",
        "type" : "double"
      }, {
        "name" : "received_kg",
        "type" : "double"
      } ]
    }
  }, {
    "name" : "state_extra",
    "type" : {
      "type" : "map",
      "values" : "double"
    },
    "doc" : "state variables that depend on the instance's parameters, e.g. one counter per configured appliance",
    "default" : { }
  }, {
    "name" : "outputs",
    "type" : {
      "type" : "record",
      "name" : "H2ConsumerOutputs",
      "doc" : "Output ports of h2-consumer",
      "fields" : [ {
        "name" : "request_kgph",
        "type" : {
          "type" : "record",
          "name" : "PortValue",
          "namespace" : "org.opentsx.twin.v1",
          "doc" : "Value with origin.",
          "fields" : [ {
            "name" : "value",
            "type" : "double"
          }, {
            "name" : "origin",
            "type" : {
              "type" : "enum",
              "name" : "Origin",
              "doc" : "Origin ladder, best first; a value is as good as its worst input.",
              "symbols" : [ "MEASURED", "REPORTED", "FORECAST", "ESTIMATED", "SYNTHETIC" ]
            }
          } ]
        },
        "doc" : "SIGNAL [kg/h]"
      } ]
    }
  }, {
    "name" : "controls",
    "type" : {
      "type" : "record",
      "name" : "H2ConsumerControls",
      "doc" : "Controls of h2-consumer overridden by interventions (null: policy decides)",
      "fields" : [ ]
    }
  } ],
  "opentsx.atomType" : "h2-consumer",
  "opentsx.phase" : "SOURCES",
  "opentsx.inputs" : [ {
    "name" : "demand_kgph",
    "kind" : "FLOW",
    "unit" : "kg/h"
  }, {
    "name" : "m_in_kgph",
    "kind" : "FLOW",
    "unit" : "kg/h"
  } ]
}
