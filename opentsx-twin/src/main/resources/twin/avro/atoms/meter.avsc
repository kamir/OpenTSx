{
  "type" : "record",
  "name" : "MeterSnapshot",
  "namespace" : "org.opentsx.twin.v1.atoms",
  "doc" : "Snapshot of one meter atom after superstep k (phase BALANCE)",
  "fields" : [ {
    "name" : "run_id",
    "type" : "string"
  }, {
    "name" : "atom",
    "type" : "string",
    "doc" : "instance id, the record key"
  }, {
    "name" : "k",
    "type" : "int"
  }, {
    "name" : "t",
    "type" : {
      "type" : "long",
      "logicalType" : "timestamp-micros"
    }
  }, {
    "name" : "state",
    "type" : {
      "type" : "record",
      "name" : "MeterState",
      "doc" : "State variables of meter",
      "fields" : [ {
        "name" : "import_kwh",
        "type" : "double"
      }, {
        "name" : "cost_eur",
        "type" : "double"
      }, {
        "name" : "peak_kw",
        "type" : "double"
      }, {
        "name" : "base_kwh",
        "type" : "double"
      }, {
        "name" : "base_h",
        "type" : "double"
      }, {
        "name" : "residual_kwh",
        "type" : "double"
      } ]
    }
  }, {
    "name" : "state_extra",
    "type" : {
      "type" : "map",
      "values" : "double"
    },
    "doc" : "state variables that depend on the instance's parameters, e.g. one counter per configured appliance",
    "default" : { }
  }, {
    "name" : "outputs",
    "type" : {
      "type" : "record",
      "name" : "MeterOutputs",
      "doc" : "Output ports of meter",
      "fields" : [ {
        "name" : "p_import_kw",
        "type" : {
          "type" : "record",
          "name" : "PortValue",
          "namespace" : "org.opentsx.twin.v1",
          "doc" : "Value with origin.",
          "fields" : [ {
            "name" : "value",
            "type" : "double"
          }, {
            "name" : "origin",
            "type" : {
              "type" : "enum",
              "name" : "Origin",
              "doc" : "Origin ladder, best first; a value is as good as its worst input.",
              "symbols" : [ "MEASURED", "REPORTED", "FORECAST", "ESTIMATED", "SYNTHETIC" ]
            }
          } ]
        },
        "doc" : "FLOW [kW]"
      }, {
        "name" : "residual_kw",
        "type" : "org.opentsx.twin.v1.PortValue",
        "doc" : "FLOW [kW]"
      } ]
    }
  }, {
    "name" : "controls",
    "type" : {
      "type" : "record",
      "name" : "MeterControls",
      "doc" : "Controls of meter overridden by interventions (null: policy decides)",
      "fields" : [ ]
    }
  } ],
  "opentsx.atomType" : "meter",
  "opentsx.phase" : "BALANCE",
  "opentsx.inputs" : [ {
    "name" : "p_appl_kw",
    "kind" : "FLOW",
    "unit" : "kW"
  }, {
    "name" : "p_heating_kw",
    "kind" : "FLOW",
    "unit" : "kW"
  }, {
    "name" : "p_meas_kw",
    "kind" : "FLOW",
    "unit" : "kW"
  }, {
    "name" : "price_eur_kwh",
    "kind" : "SIGNAL",
    "unit" : "EUR/kWh"
  } ]
}
