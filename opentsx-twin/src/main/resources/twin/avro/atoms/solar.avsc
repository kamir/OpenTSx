{
  "type" : "record",
  "name" : "SolarSnapshot",
  "namespace" : "org.opentsx.twin.v1.atoms",
  "doc" : "Snapshot of one solar atom after superstep k (phase ASSETS)",
  "fields" : [ {
    "name" : "run_id",
    "type" : "string"
  }, {
    "name" : "atom",
    "type" : "string",
    "doc" : "instance id, the record key"
  }, {
    "name" : "k",
    "type" : "int"
  }, {
    "name" : "t",
    "type" : {
      "type" : "long",
      "logicalType" : "timestamp-micros"
    }
  }, {
    "name" : "state",
    "type" : {
      "type" : "record",
      "name" : "SolarState",
      "doc" : "State variables of solar",
      "fields" : [ {
        "name" : "yield_wh",
        "type" : "double"
      }, {
        "name" : "peak_w",
        "type" : "double"
      } ]
    }
  }, {
    "name" : "state_extra",
    "type" : {
      "type" : "map",
      "values" : "double"
    },
    "doc" : "state variables that depend on the instance's parameters, e.g. one counter per configured appliance",
    "default" : { }
  }, {
    "name" : "outputs",
    "type" : {
      "type" : "record",
      "name" : "SolarOutputs",
      "doc" : "Output ports of solar",
      "fields" : [ {
        "name" : "p_avail_w",
        "type" : {
          "type" : "record",
          "name" : "PortValue",
          "namespace" : "org.opentsx.twin.v1",
          "doc" : "Value with origin.",
          "fields" : [ {
            "name" : "value",
            "type" : "double"
          }, {
            "name" : "origin",
            "type" : {
              "type" : "enum",
              "name" : "Origin",
              "doc" : "Origin ladder, best first; a value is as good as its worst input.",
              "symbols" : [ "MEASURED", "REPORTED", "FORECAST", "ESTIMATED", "SYNTHETIC" ]
            }
          } ]
        },
        "doc" : "FLOW [W]"
      }, {
        "name" : "ghi_wm2",
        "type" : "org.opentsx.twin.v1.PortValue",
        "doc" : "SIGNAL [W/m2]"
      } ]
    }
  }, {
    "name" : "controls",
    "type" : {
      "type" : "record",
      "name" : "SolarControls",
      "doc" : "Controls of solar overridden by interventions (null: policy decides)",
      "fields" : [ {
        "name" : "wp",
        "type" : [ "null", "double" ],
        "doc" : "default 200.0",
        "default" : null
      }, {
        "name" : "derate",
        "type" : [ "null", "double" ],
        "doc" : "default 0.75",
        "default" : null
      } ]
    }
  } ],
  "opentsx.atomType" : "solar",
  "opentsx.phase" : "ASSETS",
  "opentsx.inputs" : [ {
    "name" : "mode",
    "kind" : "SIGNAL",
    "unit" : "1"
  }, {
    "name" : "ghi_wm2",
    "kind" : "SIGNAL",
    "unit" : "W/m2"
  }, {
    "name" : "p_meas_w",
    "kind" : "FLOW",
    "unit" : "W"
  } ]
}
