{
  "type" : "record",
  "name" : "H2LineSnapshot",
  "namespace" : "org.opentsx.twin.v1.atoms",
  "doc" : "Snapshot of one h2-line atom after superstep k (phase FLOWS)",
  "fields" : [ {
    "name" : "run_id",
    "type" : "string"
  }, {
    "name" : "atom",
    "type" : "string",
    "doc" : "instance id, the record key"
  }, {
    "name" : "k",
    "type" : "int"
  }, {
    "name" : "t",
    "type" : {
      "type" : "long",
      "logicalType" : "timestamp-micros"
    }
  }, {
    "name" : "state",
    "type" : {
      "type" : "record",
      "name" : "H2LineState",
      "doc" : "State variables of h2-line",
      "fields" : [ {
        "name" : "mass_kg",
        "type" : "double"
      }, {
        "name" : "p_bar",
        "type" : "double"
      }, {
        "name" : "p_max_bar",
        "type" : "double"
      }, {
        "name" : "warned",
        "type" : "double"
      }, {
        "name" : "low",
        "type" : "double"
      } ]
    }
  }, {
    "name" : "state_extra",
    "type" : {
      "type" : "map",
      "values" : "double"
    },
    "doc" : "state variables that depend on the instance's parameters, e.g. one counter per configured appliance",
    "default" : { }
  }, {
    "name" : "outputs",
    "type" : {
      "type" : "record",
      "name" : "H2LineOutputs",
      "doc" : "Output ports of h2-line",
      "fields" : [ {
        "name" : "p_bar",
        "type" : {
          "type" : "record",
          "name" : "PortValue",
          "namespace" : "org.opentsx.twin.v1",
          "doc" : "Value with origin.",
          "fields" : [ {
            "name" : "value",
            "type" : "double"
          }, {
            "name" : "origin",
            "type" : {
              "type" : "enum",
              "name" : "Origin",
              "doc" : "Origin ladder, best first; a value is as good as its worst input.",
              "symbols" : [ "MEASURED", "REPORTED", "FORECAST", "ESTIMATED", "SYNTHETIC" ]
            }
          } ]
        },
        "doc" : "SIGNAL [bar]"
      }, {
        "name" : "ttl_min",
        "type" : "org.opentsx.twin.v1.PortValue",
        "doc" : "SIGNAL [min]"
      }, {
        "name" : "headroom_kg",
        "type" : "org.opentsx.twin.v1.PortValue",
        "doc" : "SIGNAL [kg]"
      }, {
        "name" : "m_net_kgph",
        "type" : "org.opentsx.twin.v1.PortValue",
        "doc" : "FLOW [kg/h]"
      } ]
    }
  }, {
    "name" : "controls",
    "type" : {
      "type" : "record",
      "name" : "H2LineControls",
      "doc" : "Controls of h2-line overridden by interventions (null: policy decides)",
      "fields" : [ ]
    }
  } ],
  "opentsx.atomType" : "h2-line",
  "opentsx.phase" : "FLOWS",
  "opentsx.inputs" : [ {
    "name" : "m_in_kgph",
    "kind" : "FLOW",
    "unit" : "kg/h"
  }, {
    "name" : "m_out_kgph",
    "kind" : "FLOW",
    "unit" : "kg/h"
  } ]
}
