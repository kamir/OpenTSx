{
  "type" : "record",
  "name" : "AppliancesSnapshot",
  "namespace" : "org.opentsx.twin.v1.atoms",
  "doc" : "Snapshot of one appliances atom after superstep k (phase SOURCES)",
  "fields" : [ {
    "name" : "run_id",
    "type" : "string"
  }, {
    "name" : "atom",
    "type" : "string",
    "doc" : "instance id, the record key"
  }, {
    "name" : "k",
    "type" : "int"
  }, {
    "name" : "t",
    "type" : {
      "type" : "long",
      "logicalType" : "timestamp-micros"
    }
  }, {
    "name" : "state",
    "type" : {
      "type" : "record",
      "name" : "AppliancesState",
      "doc" : "State variables of appliances",
      "fields" : [ {
        "name" : "el_kwh",
        "type" : "double"
      }, {
        "name" : "standby_kwh",
        "type" : "double"
      }, {
        "name" : "gain_kwh",
        "type" : "double"
      } ]
    }
  }, {
    "name" : "state_extra",
    "type" : {
      "type" : "map",
      "values" : "double"
    },
    "doc" : "state variables that depend on the instance's parameters, e.g. one counter per configured appliance",
    "default" : { }
  }, {
    "name" : "outputs",
    "type" : {
      "type" : "record",
      "name" : "AppliancesOutputs",
      "doc" : "Output ports of appliances",
      "fields" : [ {
        "name" : "p_el_kw",
        "type" : {
          "type" : "record",
          "name" : "PortValue",
          "namespace" : "org.opentsx.twin.v1",
          "doc" : "Value with origin.",
          "fields" : [ {
            "name" : "value",
            "type" : "double"
          }, {
            "name" : "origin",
            "type" : {
              "type" : "enum",
              "name" : "Origin",
              "doc" : "Origin ladder, best first; a value is as good as its worst input.",
              "symbols" : [ "MEASURED", "REPORTED", "FORECAST", "ESTIMATED", "SYNTHETIC" ]
            }
          } ]
        },
        "doc" : "FLOW [kW]"
      }, {
        "name" : "q_gain_kw",
        "type" : "org.opentsx.twin.v1.PortValue",
        "doc" : "FLOW [kW]"
      } ]
    }
  }, {
    "name" : "controls",
    "type" : {
      "type" : "record",
      "name" : "AppliancesControls",
      "doc" : "Controls of appliances overridden by interventions (null: policy decides)",
      "fields" : [ {
        "name" : "standby_off",
        "type" : [ "null", "double" ],
        "doc" : "default 0.0",
        "default" : null
      } ]
    }
  } ],
  "opentsx.atomType" : "appliances",
  "opentsx.phase" : "SOURCES",
  "opentsx.inputs" : [ ]
}
