<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>opentsx</artifactId>
        <groupId>org.opentsx</groupId>
        <version>3.0.1</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>opentsx-openmetadata</artifactId>
    <name>opentsx-openmetadata</name>
    <description>
        Publishes the wind-farm metadata pool to OpenMetadata 2.0: glossary from the IEC 61400-25-2 data-point
        catalog, tags, custom properties, KafScale topics with Avro schemas, Iceberg tables, pipelines, lineage,
        table profiles and data-quality results from streaming statistics.
    </description>

    <properties>
        <!-- server version the payloads are validated against (JSON schemas of openmetadata-spec) -->
        <openmetadata.version>2.0.5</openmetadata.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.opentsx</groupId>
            <artifactId>opentsx-windpark</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.opentsx</groupId>
            <artifactId>opentsx-stats</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.opentsx</groupId>
            <artifactId>opentsx-store-iceberg</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- tests: request bodies are validated against the official OpenMetadata JSON schemas (resources only;
             the spec classes need Java 21 and are not loaded) -->
        <dependency>
            <groupId>org.open-metadata</groupId>
            <artifactId>openmetadata-spec</artifactId>
            <version>${openmetadata.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>1.5.9</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <org.slf4j.simpleLogger.defaultLogLevel>warn</org.slf4j.simpleLogger.defaultLogLevel>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
