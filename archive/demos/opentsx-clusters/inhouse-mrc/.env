export JAVA_HOME=/Library/Java/JavaVirtualMachines/jdk1.8.0_221.jdk/Contents/Home
export CONFLUENT_HOME="<confluent-home>"

export CONFLUENT_DOCKER_TAG=5.5.1
export REPOSITORY=confluentinc

export MDC1="<mdc1-address>"
export MDC2="<mdc2-address>"
export MDC3="<mdc3-address>"

echo " #################"
echo "  START MDC: $1   "
echo " #################"
echo " "
echo " >    MDC1                 : $MDC1"
echo " >    MDC2                 : $MDC2"
echo " >    MDC3                 : $MDC3"
echo " "
echo " >>>  Repository           : $REPOSITORY"
echo " >>>  CONFLUENT_DOCKER_TAG : $CONFLUENT_DOCKER_TAG"
echo " "

