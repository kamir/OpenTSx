# OpenTSx configuration example
#
# This file lists only keys that the code actually reads. Copy it to ./opentsx.properties (working directory)
# and adjust. Real hosts and credentials belong in config/private/ (git-ignored), never in a committed file.

# --- 2.x tools: ProductionConfig (opentsx-core, read from ./opentsx.properties) ----------------------------------
# Environment variables (OPENTSX_DATA_DIRECTORY, OPENTSX_THREADS_POOL_SIZE, ...) take precedence.
opentsx.data.directory=/var/lib/opentsx/data
opentsx.threads.pool.size=4
opentsx.retry.attempts=3
# SEVERE, WARNING, INFO, FINE, FINER, FINEST
opentsx.log.level=INFO

# --- 2.x tools: ConfigManager (opentsx-core, opentsx-lg, opentsx-connectors) --------------------------------------
# Defaults live in config/opentsx-default.properties; select another file with OPENTSX_CONFIG_FILE=<path> or
# OPENTSX_CONFIG_PROFILE=<name> (-> config/opentsx-<name>.properties). JVM system properties and environment
# variables (literal key or OPENTSX_<KEY>) win over files.
opentsx.demo.output.dir=./data/temp
opentsx.demo.output.format=csv
opentsx.number.of.iterations=3
opentsx.show.gui=false
opentsx.use.kafka=false

# Kafka client profile of the 2.x tools: set OPENTSX_PRIMARY_CLUSTER_CLIENT_CFG_FILE_NAME (environment);
# default ./config/opentsx-local.props, template config/opentsx-local.props.example (localhost / KafScale).
# Topic list: OPENTSX_TOPIC_MAP_FILE_NAME, default ./config/topiclist.def.

# --- v2 modules (bin/opentsx ...) ----------------------------------------------------------------------------------
# The v2 modules (opentsx-kafka-v2, -windpark, -stats, -retrieval, -store-*, -openmetadata, -twin) do not read a
# properties file. They are configured with command-line options and a few environment variables:
#
#   KafScale / Kafka   --kafscale localhost:9092 --domain wind --partitions 6
#                      (tests and deploy scripts: KAFSCALE_BOOTSTRAP=localhost:9092)
#   Iceberg            --iceberg type=jdbc,uri=jdbc:sqlite:/tmp/tsx/catalog.db,warehouse=file:/tmp/tsx/warehouse
#                      --namespace tsx      (or type=rest,uri=...,warehouse=...)
#   OpenTSDB           OPENTSDB_URL=http://localhost:4242   (store contract test against a real OpenTSDB)
#   OpenMetadata       --om http://localhost:8585/api, token via --token or OPENMETADATA_JWT
#   Retrieval server   bin/opentsx retrieval-server --port 8080 [--iceberg ... | --demo true]
#                      (Python client tests: OPENTSX_RETRIEVAL_URL=http://127.0.0.1:8080)
#
# See docs/user-manual/12-operations.md and docs/user-manual/appendix-a-cli.md.
