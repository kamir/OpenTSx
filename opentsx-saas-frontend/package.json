{
  "name": "opentsx-saas-frontend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "OpenTSx SaaS Platform - React Frontend with Visual Flow Builder",
  "dependencies": {
    "@tanstack/react-query": "^5.108.0",
    "axios": "^1.21.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.5",
    "reactflow": "^11.10.4",
    "socket.io-client": "^4.8.4",
    "zustand": "^4.4.7"
  },
  "scripts": {
    "dev": "vite",
    "demo": "vite --host 127.0.0.1 --strictPort --open \"/workbench?mode=engineer&demo=thermal\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "check:local": "tsc --noEmit && npm run lint && vitest related --run --passWithNoTests=false",
    "preview:test": "vite preview --port 4173",
    "test": "vitest",
    "test:demo": "vitest run src/workbench/WorkbenchDemo.test.tsx src/workbench/deviceSample.test.ts",
    "test:demo:browser": "node scripts/demo-smoke.mjs",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write src/"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.2.0",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "25.0.3",
    "@types/react": "^18.2.47",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^23.1.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  }
}
