{
  "type": "record",
  "name": "ResultCurve",
  "namespace": "org.opentsx.model.v2",
  "doc": "A function of something other than time, e.g. the DFA fluctuation function F(s) or the MFDFA spectrum f(alpha). x and y have the same length.",
  "fields": [
    {"name": "name", "type": "string", "doc": "e.g. fluctuation, h_q, f_alpha."},
    {"name": "xName", "type": "string", "doc": "e.g. scale, q, alpha."},
    {"name": "xUnit", "type": ["null", "string"], "default": null},
    {"name": "x", "type": {"type": "array", "items": "double"}},
    {"name": "y", "type": {"type": "array", "items": "double"}},
    {"name": "unit", "type": ["null", "string"], "default": null, "doc": "Unit of y."}
  ]
}
