# Application Settings
PROJECT_NAME=OpenTSx SaaS Platform
API_V1_STR=/api/v1
DEBUG=True

# Security - ⚠️ CHANGE THESE IN PRODUCTION!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-this-in-production-use-random-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# PostgreSQL Database Configuration
POSTGRES_DB=opentsx
POSTGRES_USER=opentsx_user
POSTGRES_PASSWORD=change_this_password
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PASSWORD=change_this_redis_password
REDIS_PORT=6379

# Database URL (for application)
# Format: postgresql+asyncpg://username:password@host:port/database
# For Docker Compose: use 'postgres' as host
# For local development: use 'localhost' as host
DATABASE_URL=postgresql+asyncpg://opentsx_user:change_this_password@postgres:5432/opentsx

# Redis URL (for application)
REDIS_URL=redis://:change_this_redis_password@redis:6379/0

# Backend Port
BACKEND_PORT=8000

# First Superuser (Created automatically on first run)
# ⚠️ CHANGE THESE IN PRODUCTION!
FIRST_SUPERUSER_EMAIL=admin@opentsx.com
FIRST_SUPERUSER_PASSWORD=admin123

# CORS (Allowed origins for frontend)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Optional: Email Configuration (for verification emails)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAILS_FROM_EMAIL=noreply@opentsx.com
