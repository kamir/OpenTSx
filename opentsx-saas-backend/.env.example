# Copy to .env, which git ignores. docker compose reads it for docker-compose.yml; the backend reads it
# (app/core/config.py) when it runs outside a container.

# Application Settings
PROJECT_NAME=OpenTSx SaaS Platform
API_V1_STR=/api/v1

# Required: no default, the backend and docker compose refuse to start without them.
# Generate each value with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# SECRET_KEY signs the login tokens and needs at least 32 characters.
SECRET_KEY=
# At least 12 characters each; FIRST_SUPERUSER_PASSWORD at most 72 bytes in UTF-8.
POSTGRES_PASSWORD=
FIRST_SUPERUSER_PASSWORD=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# PostgreSQL Database Configuration
# POSTGRES_SERVER applies outside a container; docker-compose.yml sets postgres.
POSTGRES_SERVER=localhost
POSTGRES_DB=opentsx
POSTGRES_USER=opentsx_user
# docker-compose.yml publishes PostgreSQL on 127.0.0.1 at this port
POSTGRES_PORT=5432

# First Superuser (created at start when no administrator exists; an existing account keeps its password)
FIRST_SUPERUSER_EMAIL=admin@opentsx.com

# CORS (Allowed origins for frontend)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ENABLE_SIGNUP=false closes registration; LOG_LEVEL is one of DEBUG, INFO, WARNING, ERROR
# ENABLE_SIGNUP=true
# LOG_LEVEL=INFO
